<mjml lang="en">
  <mj-head>
    <!-- en-tools-config {
      "spacingScale": { "None": 0, "Third": 6, "Half": 9, "Single": 18, "Double": 36, "Triple": 54 },
      "widthPresets": { "Full Bleed": 0, "Half": 9, "Single": 18, "Double": 36 },
      "geometryReachPx": 54,
      "brandColors": { "ASPCA Orange": "#FF6300", "Ink": "#202020", "Charcoal": "#363636", "Slate": "#656565", "Steel Blue": "#3B6E91", "Sky": "#2BAADF", "Silver": "#EAEAEA", "Cloud": "#F0F0F0", "Mist": "#EEEEEE", "Off White": "#FAFAFA", "White": "#FFFFFF" }
    } -->
    <!--
      ASPCA block catalog. The importer turns this file into the EN template
      and the block library; the three autoresponders in src/autoresponders/
      are built from these same blocks and check-sync holds them in step.

      The spacing scale is the sources' own, not TPL's: the Mailchimp
      templates these emails came from pace on a 9px grid (9px block insets,
      18px gutters), so the scale runs on 18 with a 6px step for the two
      small gaps they use (the space above the Guardian footer and the
      social bar's inset). Paragraph margins stay at Mailchimp's 10px and are
      not trimmed; see styles.css. The en-tools-config above must be
      byte-identical in every src page (check-sync asserts it).

      Light only: neither source supports dark mode, so there are no
      color-scheme metas and no light/dark twins.

      The template shell follows the Guardian (monthly) email: a #eeeeee page
      with a 10px gutter round a 600px white card. The one-time and annual
      pages use a #fafafa page with no gutter; that lives in their own shells.
    -->
    <mj-breakpoint width="480px" />
    <mj-title>ASPCA Email Template — Block Catalog</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#202020" font-size="16px" line-height="24px" padding="0" css-class="wysiwyg" />
      <mj-image padding="0" />
      <mj-divider padding="0" />
    </mj-attributes>
    <!-- Marketing Tools builder bands (copied from TPL). data-en-tools-band
         keeps this sheet in the template head instead of the Template Styles
         block. Neither rule matches anything in a delivered email, so EN's
         inliner prunes both at send. Never write EN's container merge tag
         literally in this file (guide section 6). -->
    <mj-raw>
      <style type="text/css" data-en-tools-band>
        div[data-container] { max-width: 600px; margin: 0 auto; }
        [data-container="main"]:before{
          content: "ASPCA Email Template v__TEMPLATE_VERSION__";
          display: block !important;
          font-weight: 700 !important;
          font-family: sans-serif !important;
          color: #4e535c !important;
          line-height: 1.75rem !important;
          text-align: center !important;
          margin-bottom: 2rem !important;
          background-color: #d0d5dd !important;
        }
        :is(body):has(.en__emailbuilder__block) .marketing-tools-banner{
          display: flex !important;
          font-weight: 700 !important;
          font-family: sans-serif !important;
          color: #4e535c !important;
          line-height: 2rem !important;
          top: 1.75rem !important;
          width: 100% !important;
          max-width: 600px !important;
          justify-content: center !important;
          background-color: #d0d5dd !important;
        }
        :is(body):has(.en__emailbuilder__block) #head-styles{
          position: absolute !important;
        }
      </style>
    </mj-raw>
    <mj-include path="./styles.css" type="css" />
  </mj-head>
  <mj-body background-color="#eeeeee" css-class="email-body">
    <!-- The Guardian email's 10px page gutter (Mailchimp's #bodyCell). Outlook
         ignores div padding and renders the fixed 600px tables, as before. -->
    <mj-raw><div style="padding:10px;"></mj-raw>
    <!-- START: Main Content -->

    <!-- START: Preheader Text -->
    <!-- The one-time and annual emails show their preheader as a visible line
         on the page ground. 18px above and below with a 16px line reproduces
         the source's 10 + 9 + 14 + 9 + 10. No background: it sits on the page. -->
    <mj-section css-class="block preheader-block" padding="18px 18px">
      <mj-column>
        <mj-text align="center" color="#000000" font-size="12px" line-height="16px">Your gift will make a big impact on the lives of animals in need. Thank you for supporting the ASPCA.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="0px" />
      </mj-column>
    </mj-section>
    <!-- END: Preheader Text -->

    <!-- START: Header Image -->
    <!-- The 9px white strip above the photo is the source's preheader cell
         (monthly) or #templateHeader padding (one-time). No width: the image
         fills the column, so any gutter an editor picks still fits. -->
    <mj-section css-class="block header-block" background-color="#ffffff" padding="9px 0 0">
      <mj-column>
        <mj-image src="assets/aspca-auto-ack-redesign-top-image.jpg" alt="Thank You" href="https://www.aspca.org/guardians?ms=em_ack_top-banner-monthly-guardianpage-201909&initialms=em_ack_top-banner-monthly-guardianpage-201909&utm_medium=email&utm_campaign=auto-acknowledgement&utm_source=monthly-guardianpage-201909" />
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="9px" />
      </mj-column>
    </mj-section>
    <!-- END: Header Image -->

    <!-- START: WYSIWYG Text -->
    <mj-section css-class="block text-block" background-color="#ffffff" padding="0 18px">
      <mj-column>
        <mj-text>
          <p>Thank you for becoming the newest member of the ASPCA Guardian monthly giving program! Your generosity means so much to us and the animals we serve. We have successfully processed your gift of {receipt_data~amount~[en1]} and your subsequent gifts will be processed around the 20th of each month.&nbsp;</p>
          <p>Your monthly support serves as a dependable source of funds for the ASPCA, allowing us to respond to animals in danger at a moment's notice.</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="18px" />
      </mj-column>
    </mj-section>
    <!-- END: WYSIWYG Text -->

    <!-- START: Image 1x1 (inset) -->
    <!-- On the 18px content baseline, like the copy around it. -->
    <mj-section css-class="block image-block" background-color="#ffffff" padding="0 18px">
      <mj-column>
        <mj-image src="assets/aspca-GUARDIAN_CONFIRM_EMAIL_IMG_UPDATE_V3.png" alt="Guardian Benefits" />
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="18px" />
      </mj-column>
    </mj-section>
    <!-- END: Image 1x1 (inset) -->

    <!-- START: Heading (centered) -->
    <!-- The heading's color comes from the mj-text attribute: styles.css sets
         no h1 color, so the h1 inherits it and the importer mints a Text
         Color field (guide section 5). -->
    <mj-section css-class="block heading-block" background-color="#ffffff" padding="0 18px">
      <mj-column>
        <mj-text align="center">
          <h1>More Ways to Take Action</h1>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="9px" />
      </mj-column>
    </mj-section>
    <!-- END: Heading (centered) -->

    <!-- START: Divider -->
    <mj-section css-class="block divider-block" background-color="#ffffff" padding="18px 18px">
      <mj-column>
        <mj-divider border-width="2px" border-style="solid" border-color="#EAEAEA" />
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="9px" />
      </mj-column>
    </mj-section>
    <!-- END: Divider -->

    <!-- START: Signature -->
    <!-- Three members, so each gets its own Display toggle. The paragraphs
         pin margin:0 inline: in the sources the sign-off, the signature and
         the name run as lines of one paragraph, not as spaced paragraphs. -->
    <mj-section css-class="block signature-block" background-color="#ffffff" padding="0 18px">
      <mj-column>
        <mj-text padding="0 0 18px">
          <p style="margin:0;">Sincerely,</p>
        </mj-text>
        <mj-image src="assets/aspca-matt-bershadker-signature_guardian.jpg" alt="Signature" width="144px" align="left" padding="0 0 6px" />
        <mj-text>
          <p style="margin:0;">Matt Bershadker<br />ASPCA President &amp; CEO</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="18px" />
      </mj-column>
    </mj-section>
    <!-- END: Signature -->

    <!-- START: Gift Receipt -->
    <!-- The one-time/annual receipt: 12/18 type straight on the card. The
         details and the tax line are separate texts so each can be edited or
         hidden alone. Merge tags are EN's, matching ASPCA's EN receipts in
         engrid-aspca; README lists every Springboard token they replace. -->
    <mj-section css-class="block receipt-block" background-color="#ffffff" padding="0 18px">
      <mj-column>
        <mj-text css-class="wysiwyg receipt-text" font-size="12px" line-height="18px">
          <p>{user_data~First Name} {user_data~Last Name}<br />{user_data~Address 1} {user_data~Address 2}, {user_data~City}, {user_data~Region} {user_data~Postcode}<br />Donation Date: {receipt_data~createdOn~[MMMM d, yyyy]}<br />Donation Amount: {receipt_data~amount~[en1]}<br />Donation Type: One-time<br />Payment Type: {receipt_data~paymentType}<br />Transaction ID: {receipt_data~txId}</p>
        </mj-text>
        <mj-text css-class="wysiwyg receipt-text" font-size="12px" line-height="18px">
          <p>Your gift may be tax deductible as a charitable contribution for federal income purposes to the extent allowed under applicable law. The ASPCA provided no goods or services as consideration, in whole or in part for your contribution. The ASPCA federal tax identification number is 13-1623829. You may print this page as your receipt for tax purposes.</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="18px" />
      </mj-column>
    </mj-section>
    <!-- END: Gift Receipt -->

    <!-- START: Gift Receipt (boxed) -->
    <!-- The Guardian receipt: a #f0f0f0 panel inset 18px from the card. The
         panel is a section inside a white wrapper so its bottom inset is a
         frame padding; columns never carry bottom padding (guide section 3). -->
    <mj-wrapper css-class="block receipt-block" background-color="#ffffff" padding="0 18px">
      <mj-section background-color="#F0F0F0" padding="18px">
        <mj-column>
          <mj-text css-class="wysiwyg receipt-text" color="#363636" font-size="14px" line-height="21px" padding="0 0 18px">
            <p style="margin:0;">{user_data~First Name} {user_data~Last Name}<br />{user_data~Address 1} {user_data~Address 2}, {user_data~City}, {user_data~Region} {user_data~Postcode}<br />Donation Date: {receipt_data~createdOn~[MMMM d, yyyy]}<br />Donation Amount: {receipt_data~amount~[en1]}<br />Donation Type: Monthly&nbsp;<br />Payment Type: {receipt_data~paymentType}<br />Transaction ID: {receipt_data~txId}</p>
          </mj-text>
          <mj-text css-class="wysiwyg receipt-text" color="#363636" font-size="14px" line-height="21px">
            <p style="margin:0;"><em>Your gift may be tax deductible as a charitable contribution for federal income purposes to the extent allowed under applicable law. The ASPCA provided no goods or services as consideration, in whole or in part for your contribution. The ASPCA federal tax identification number is 13-1623829. You may print this page as your receipt for tax purposes.</em></p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section css-class="spacer-block block" background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="9px" />
      </mj-column>
    </mj-section>
    <!-- END: Gift Receipt (boxed) -->

    <!-- START: Images 2x2 -->
    <!-- Two 50% columns of the 564px content box (282px each), each holding a
         264px tile pinned to the outer edge: tiles sit at 18 and 318, 36px
         apart, exactly as the sources' image group. Rows stack row-first on a
         phone (car, volunteer, shop, advocate). data-no-link-toggle: these
         tiles exist to be clicked, so the link is never optional. -->
    <mj-section css-class="block image-grid-block" background-color="#ffffff" padding="9px 18px">
      <mj-column css-class="image-grid-left">
        <mj-image src="assets/aspca-ack-confirmation-pg-ad-car-donate-Nov2024_r1.jpg" alt="Donate Your Car" href="https://aspca.careasy.org/home?utm_source=ASPCA&utm_medium=email&utm_campaign=confirmationemail-guardian" width="264px" align="left" fluid-on-mobile="true" data-no-link-toggle />
      </mj-column>
      <mj-column>
        <mj-image src="assets/aspca-ack-confirmation-pg-volunteer-or-foster_Jan2025.jpg" alt="Volunteer or Foster" href="https://www.aspca.org/get-involved/volunteer?ms=em_ack_monthly-202411&initialms=em_ack_monthly-202411&utm_medium=email&utm_campaign=auto-acknowledgement&utm_source=monthly-202411" width="264px" align="right" fluid-on-mobile="true" data-no-link-toggle />
      </mj-column>
    </mj-section>
    <mj-section css-class="block image-grid-block" background-color="#ffffff" padding="9px 18px">
      <mj-column css-class="image-grid-left">
        <mj-image src="assets/aspca-ack-confirmation-pg-shop-aspca-gear_Nov2024_r1-v2.jpg" alt="Shop ASPCA Gear" href="https://www.amazon.com/shopaspca?channel=DonationConfirmationEmail202411" width="264px" align="left" fluid-on-mobile="true" data-no-link-toggle />
      </mj-column>
      <mj-column>
        <mj-image src="assets/aspca-ack-confirmation-pg-advocate-for-animals_Nov2024_r1.jpg" alt="Advocate for Animals" href="https://www.aspca.org/get-involved/advocacy-center?ms=em_ack_onetime-202411&initialms=em_ack_onetime-202411&utm_medium=email&utm_campaign=auto-acknowledgement&utm_source=onetime-202411" width="264px" align="right" fluid-on-mobile="true" data-no-link-toggle />
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="6px" />
      </mj-column>
    </mj-section>
    <!-- END: Images 2x2 -->

    <!-- START: Footer (links) -->
    <!-- The Guardian footer. 36px above and below reproduces the source's
         18px inset plus the empty line it opens and closes with. The second
         band is the card's bottom edge (9px white, 2px #eaeaea rule): the
         source's malformed nesting puts the footer INSIDE the white card, so
         the edge renders below it. Kept because it is what readers see.
         data-mobile-only-width: the Inert Audit measured Padding Left/Right
         inert at 600px and live at 375px, because every centered line is far
         shorter than the content box. That inertness comes from the copy, not
         the layout (guide section 5 prefers structural claims only); a footer
         line longer than about 490px would bring the control alive on desktop
         under a label that says Mobile. Accepted for fixed boilerplate. -->
    <mj-section css-class="block footer-block" background-color="#FAFAFA" padding="36px 18px" data-mobile-only-width>
      <mj-column>
        <mj-text css-class="wysiwyg footer-text link-charcoal" align="center" color="#656565" font-size="12px" line-height="18px">
          <p style="margin:0;"><a href="https://www.aspca.org/about-us/privacy-policy">Privacy Policy</a> | <a href="https://www.aspca.org">ASPCA Website</a><br /><em>Connect with us: </em><a href="https://www.facebook.com/aspca">Facebook</a> | <a href="https://twitter.com/aspca">X</a> | <a href="https://www.instagram.com/aspca/">Instagram</a> | <a href="https://www.tiktok.com/@aspca">TikTok</a> | <a href="https://www.youtube.com/aspca">YouTube</a><br />&copy; 2026 ASPCA. All Rights Reserved.</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="block card-edge" background-color="#ffffff" border-bottom="2px solid #EAEAEA" padding="0">
      <mj-column>
        <mj-spacer height="9px" />
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="0px" />
      </mj-column>
    </mj-section>
    <!-- END: Footer (links) -->

    <!-- START: Footer (w/ social icons) -->
    <!-- The one-time/annual footer. The source's social row is ONE image with
         an HTML image map; MJML has no image map, and map links are not
         clickable in every client, so the sprite is sliced at the map's own
         area coordinates into six linked images that sit edge to edge as one
         320px strip. The wrapper's 18px bottom and 2px #eaeaea border are the
         white card's bottom edge (#templateLowerBody), above the grey footer.
         data-no-direction-toggle (on the mj-group, the frame that owns the
         flip): the six columns are one sliced image, so a Column Order
         control would only spell the strip backwards. -->
    <mj-wrapper css-class="block social-block" background-color="#ffffff" border-bottom="2px solid #EAEAEA" padding="0 18px 18px">
      <mj-section background-color="#363636" padding="6px 0">
        <mj-group width="320px" css-class="social-icons" data-no-direction-toggle>
          <mj-column width="59px"><mj-image src="assets/aspca-social-facebook.png" alt="Facebook" href="https://www.facebook.com/aspca" width="59px" data-no-link-toggle /></mj-column>
          <mj-column width="49px"><mj-image src="assets/aspca-social-x.png" alt="X" href="https://www.twitter.com/aspca" width="49px" data-no-link-toggle /></mj-column>
          <mj-column width="52px"><mj-image src="assets/aspca-social-tiktok.png" alt="TikTok" href="https://www.tiktok.com/@aspca" width="52px" data-no-link-toggle /></mj-column>
          <mj-column width="50px"><mj-image src="assets/aspca-social-youtube.png" alt="YouTube" href="http://www.youtube.com/user/aspca" width="50px" data-no-link-toggle /></mj-column>
          <mj-column width="51px"><mj-image src="assets/aspca-social-instagram.png" alt="Instagram" href="https://instagram.com/aspca/" width="51px" data-no-link-toggle /></mj-column>
          <mj-column width="59px"><mj-image src="assets/aspca-social-pinterest.png" alt="Pinterest" href="http://pinterest.com/ASPCA/" width="59px" data-no-link-toggle /></mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <mj-section css-class="block footer-block" background-color="#FAFAFA" padding="18px">
      <mj-column>
        <mj-text css-class="wysiwyg footer-text link-slate" align="center" color="#656565" font-size="12px" line-height="18px">
          <p style="margin:0;">&copy;2026 ASPCA. All Rights Reserved.<br />424 East 92nd Street New York, NY 10128<br />Visit <a href="http://www.aspca.org" target="_blank">ASPCA.org</a></p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="spacer-block block" padding="0">
      <mj-column>
        <mj-spacer height="0px" />
      </mj-column>
    </mj-section>
    <!-- END: Footer (w/ social icons) -->

    <!-- END: Main Content -->
    <mj-raw></div></mj-raw>
  </mj-body>
</mjml>

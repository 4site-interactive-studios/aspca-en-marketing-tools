  "content": "<!doctype html>\n<html lang=\"en\" dir=\"auto\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<!--[if !mso]><!-->\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<!--<![endif]-->\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<!--[if mso]>\n    <noscript>\n    <xml>\n    <o:OfficeDocumentSettings>\n      <o:AllowPNG/>\n      <o:PixelsPerInch>96</o:PixelsPerInch>\n    </o:OfficeDocumentSettings>\n    </xml>\n    </noscript>\n    <![endif]-->\n<!--[if lte mso 11]>\n    <style type=\"text/css\">\n      .mj-outlook-group-fix { width:100% !important; }\n    </style>\n    <![endif]-->\n<style type=\"text/css\" data-en-tools-band>\n    div[data-container] {\n      max-width: 600px;\n      margin: 0 auto;\n    }\n\n    [data-container=\"main\"]:before {\n      content: \"ASPCA Email Template\";\n      display: block !important;\n      font-weight: 700 !important;\n      font-family: sans-serif !important;\n      color: #4e535c !important;\n      line-height: 1.75rem !important;\n      text-align: center !important;\n      margin-bottom: 2rem !important;\n      background-color: #d0d5dd !important;\n    }\n\n    :is(body):has(.en__emailbuilder__block) .marketing-tools-banner {\n      display: flex !important;\n      font-weight: 700 !important;\n      font-family: sans-serif !important;\n      color: #4e535c !important;\n      line-height: 2rem !important;\n      top: 1.75rem !important;\n      width: 100% !important;\n      max-width: 600px !important;\n      justify-content: center !important;\n      background-color: #d0d5dd !important;\n    }\n\n    :is(body):has(.en__emailbuilder__block) #head-styles {\n      position: absolute !important;\n    }\n\n  </style>\n</head>\n<body class=\"email-body\" style=\"word-spacing:normal;background-color:{replacement~background_color};\">\n<div aria-roledescription=\"email\" role=\"article\" lang=\"en\" dir=\"auto\" style=\"word-spacing:normal;background-color:{replacement~background_color};\">\n<div style=\"padding:10px;\"><!-- START: Main Content -->{{container~main}}<!-- END: Main Content -->\n</div>\n</div>\n</body>\n</html>\n",
